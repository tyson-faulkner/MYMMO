[node name="NPCs" type="Node3D" parent="."]

[node name="Halvard" parent="NPCs" instance=ExtResource("6_npc")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.25, 17)
npc_id = &"npc_halvard"
display_name = "Serjeant Halvard"
title = "Gate Serjeant"
greeting = "The valley's gone to pieces since the king died. Make yourself useful and I'll pretend I'm glad you came."
body_color = Color(0.42, 0.45, 0.55, 1)

[node name="Maren" parent="NPCs" instance=ExtResource("6_npc")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -13, 0.25, 6)
npc_id = &"npc_maren"
display_name = "Maren Holt"
title = "Quartermaster"
greeting = "I count what we have left twice a day, and it's never more than it was."
body_color = Color(0.62, 0.5, 0.36, 1)

[node name="Ilsa" parent="NPCs" instance=ExtResource("6_npc")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 12, 0.25, -8)
npc_id = &"npc_ilsa"
display_name = "Ilsa"
title = "Skald"
greeting = "Histories decide claims, and claims decide thrones. So yes, what I write down matters rather a lot."
body_color = Color(0.35, 0.55, 0.78, 1)

[node name="Bryn" parent="NPCs" instance=ExtResource("6_npc")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -13, 0.25, -8)
npc_id = &"npc_bryn"
display_name = "Bryn Aldercott"
title = "Innkeeper"
greeting = "Bed's four coppers, and the roof only leaks over the far corner. I'd take it."
body_color = Color(0.7, 0.58, 0.42, 1)

[node name="Odda" parent="NPCs" instance=ExtResource("6_npc")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 13, 0.25, 8)
npc_id = &"npc_odda"
display_name = "Odda Vane"
title = "Armourer"
greeting = "I shod horses before the war. Now I make spear points. Nobody asked me which I preferred."
body_color = Color(0.48, 0.4, 0.36, 1)

[node name="Selle" parent="NPCs" instance=ExtResource("6_npc")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 6, 0.25, 12)
npc_id = &"npc_selle"
display_name = "Selle"
title = "Provisioner"
greeting = "Bread, rope, lamp oil. If you want anything finer you want a different valley."
body_color = Color(0.66, 0.62, 0.48, 1)

[node name="Aurey" parent="NPCs" instance=ExtResource("6_npc")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -6, 0.25, -14)
npc_id = &"npc_aurey"
display_name = "Captain Aurey"
title = "Guard Captain"
greeting = "Two houses want this road and neither one of them will say so out loud. Keep your head down."
body_color = Color(0.5, 0.44, 0.5, 1)

