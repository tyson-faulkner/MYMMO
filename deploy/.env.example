# Copy to .env and change both values. .env is gitignored — never commit it.
#
# NAKAMA_SERVER_KEY is the shared secret the game client uses to reach Nakama.
# It must match the key in the Godot client's Nakama setup.
NAKAMA_SERVER_KEY=change-me-to-a-long-random-string

# The admin console login. The console is bound to localhost, but pick a real
# password anyway.
NAKAMA_CONSOLE_USER=admin
NAKAMA_CONSOLE_PASSWORD=change-me-too
